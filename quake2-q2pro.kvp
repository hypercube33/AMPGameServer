Meta.DisplayName=Quake II - Q2PRO
Meta.Description=Linux-first Quake II dedicated server using Q2PRO with mods, custom maps, map packs, rotation, RCON and FastDL
Meta.OS=Linux
Meta.AarchSupport=NotSupported
Meta.Arch=x86_64
Meta.Author=hypercube33
Meta.URL=https://github.com/q2pro/q2pro
Meta.DisplayImageSource=steam:2320
Meta.EndpointURIFormat={ip}:{GenericModule.App.Ports.$ServerPort}
Meta.ConfigManifest=quake2-q2proconfig.json
Meta.MetaConfigManifest=quake2-q2prometaconfig.json
Meta.ConfigRoot=quake2-q2pro.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=RecommendedOnLinux
Meta.ContainerPolicyReason=The update stage builds Q2PRO from source and requires build dependencies. A container keeps them off the AMP host.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["git","meson","gcc","make","libc6-dev","zlib1g-dev","ninja-build","wget","unzip","ca-certificates"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=10
Meta.ReleaseNotes=Fix Freeze Tag source patch escaping so armor globals compile correctly
Meta.BreakingReleaseNotes=
Meta.AppConfigId=7493d00e-ec75-48c7-8a80-5759779412ce
Meta.ImportableExtensions=[".cfg"]
Meta.AppIsMultiIPAware=True
App.DisplayName=Quake II - Q2PRO
App.RootDir=./q2pro/
App.BaseDirectory=./q2pro/server/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=server/q2proded
App.WorkingDir=server
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=+set dedicated 1 +set net_ip {{$ApplicationIPBinding}} +set net_port {{$ServerPort}} +set game "{{GameDir}}" +exec amp-server.cfg +map "{{StartupMap}}" {{$FormattedArgs}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={}
App.CommandLineParameterFormat=+set {0} "{1}"
App.CommandLineParameterDelimiter= 
App.ExitMethod=String
App.ExitTimeout=15
App.ExitString=quit
App.ExitFile=
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=True
App.LiveSettingChangeCommandFormat=set {0} "{1}"
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[quake2-q2proports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ServerPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=16
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.StripANSIControlCodes=True
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=status
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}
App.TelnetNewLineType=Default
App.TailLogFilePath=baseq2/console.log
App.UpdateSources=@IncludeJson[quake2-q2proupdates.json]
App.PreStartStages=@IncludeJson[quake2-q2prostart.json]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=LinuxBufferedConsole
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["*.cfg","*.pak","*.pkz","*.bsp","*.so"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^(SpawnServer: .+|====== Q2PRO initialized ======)$
Console.UserJoinRegex=^$
Console.UserLeaveRegex=^$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.PreConnectRegex=
Console.ConnectIPRegex=
Console.MetricsRegex=
Console.ServerInfoRegex=
Console.HideFromConsoleRegex=
Console.SuppressLogAtStart=False
Console.ActivateLogRegex=
Console.UserActions={}
Limits.SleepMode=False
Limits.SleepOnStart=False
Limits.SleepDelayMinutes=5
Limits.DozeDelay=2
Limits.AutoRetryCount=2
Limits.SleepStartThresholdSeconds=25
